<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PharmacyStock</RootNamespace>
    <AssemblyName>TenPercentStockManager</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Single-file, no console window on Windows -->
    <OutputType>Exe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- This is a desktop program, not an IIS site: no web.config wanted. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>

    <Version>1.0.0</Version>
    <Product>Ten Percent Discount Pharmacy - Stock Manager</Product>
    <Company>Ten Percent Discount Pharmacy</Company>
    <AssemblyTitle>Stock Manager</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!--
    The user interface is embedded INSIDE the exe instead of shipped as loose files,
    so the whole program is a single file that can be copied anywhere and double-clicked.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
